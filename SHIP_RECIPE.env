# SHIP_RECIPE.env — every build input of the submitted compressor that is not
# source code.  `build.sh` sources this file and passes ZMIX_ENGINE_FLAGS to
# `construct_ship.sh`, which asserts each pin before it resolves a toolchain or
# compiles anything.  The pins are EXACT, not minima: a different compiler,
# packer or packer mode produces a different decompressor, and Form-1 charges
# the decompressor twice.

ZMIX_ENGINE_FLAGS="-Dvendored-libm=true -Didr=true -Dppm-order=20 -Dppmd-mmap=true -Dcmc2-hash64=true -Dlto=true -Dcmfast=true -Dmix-lr-scale=0.7 -Dmxa-uperr-scale=1.0 -Dsta6-mdc=30 -Dm0lr-comp8=false -Dfxcm-auxctx-fix=true -Dcoldram=true -Dcoldram-pool-only=true -Dcmc2-hot2=7 -Dmixer-decay-floor=0.14 -Ds7order=true -Dmixer-e2e=true -Dmixer-e2e-norm=true -Dadaptive-depth=true -Dfieldcodec-tsswap=true -Dphda9-nullpred=true -Dcm3-ts-rate=18 -Dapm-wupd=4 -Dwordlbl=true -Dsse-ffl6=4 -Dderivdict=true -Dtransformer=true -Dtransformer-prior-form=0 -Dtf-packed=true -Dextshed=true -Dtransformer-lstm-dead=true -Dtf-weights-v3=true -Dtf-load-opt=oz -Dship-evict-bytes=1500 -Dtransformer-attn=1"

# sha256 over src/ + third_party/ + build.zig + build.zig.zon (168 files), first
# 16 hex, recomputed from the extracted tree by construct_ship.sh's
# zmix_src_digest() and compared.
ZMIX_SRC_DIGEST="337bf7f326d3dd0d"
ZMIX_TREE_SHA="zmix-1.0"     # informational only, NOT asserted
ZMIX_TREE_PIN_MODE="strict"  # warn|strict

# The transformer weight blob is an asset copied verbatim into comp9's tail, not
# a compiler input, so ZMIX_SRC_DIGEST does not cover it: it gets its own sha.
# The container is selected by -Dtf-weights-v3, so path and sha move together.
ZMIX_TFWEIGHTS="${ZMIX_TFWEIGHTS:-assets/6m-q4-fp32-t1lambda1.tfwc3}"
ZMIX_TFWEIGHTS_SHA256="8e8ef3acacfb84437868035923bf9987f9adc826d2c833fb828204d2ab9c807d"     # assets/6m-q4-fp32-t1lambda1.tfwc3, 2,815,630 B, magic FX2TFWC3 — the blob THIS recipe names
ZMIX_TFWEIGHTS_V3SHIPPED_SHA256="c8919e6e1a7d4ce1d70330f8f88dff4436958282de2d1958c2c260751da5166f"  # assets/6m-q4-fp32.tfwc3, 2,840,417 B
ZMIX_TFWEIGHTS_V2_SHA256="7f4db6c8c843a7e6264b6a48ed4805e9e431f543df7a9a0ecb37a35a5e4b8860"  # assets/6m-q4-fp32.tfwc2, 2,930,652 B, magic FX2TFWC2 — used iff the recipe drops -Dtf-weights-v3

# C ABI.  The shipped engine links glibc; src/detm_math.zig exports strong
# definitions of the exp/log family from the binary itself, and tools/libm_gate.sh
# asserts libm.so.6 is absent from DT_NEEDED, so the numerics never depend on the
# host's libm.
ZMIX_ABI="glibc"

# Compiler toolchain: EXACT, not a floor.  construct_ship.sh compares `zig
# version` and aborts on any mismatch; if the host has no matching zig it runs
# tools/provision_zig.sh, which unpacks the upstream x86_64-linux release tarball
# in-tree after verifying sha256
# c61c5da6edeea14ca51ecd5e4520c6f4189ef5250383db33d01848293bfafe05.  No root, no
# package manager.  Set ZIG_SRC_TARBALL to a local copy to provision offline.
ZMIX_ZIG_VERSION="0.15.1"

# Packer toolchain.  Both lines are part of the recipe: change either and the
# decompressor changes.  upx 4.2.2 cannot pack this engine at all;
# construct_ship.sh refuses any other version and builds this one from source via
# tools/build_upx.sh when it is absent.  ZMIX_UPX_MODE is literal, never "auto".
ZMIX_UPX_VERSION="5.2.0"
ZMIX_UPX_MODE="--ultra-brute"
