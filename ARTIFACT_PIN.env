# ARTIFACT_PIN.env — the numbers the judge's rebuild is checked against.
#
# build.sh sources this file from the package root and reports each rebuilt
# component against it; under ZMIX_EXPECT_STRICT=1 a mismatch is fatal.

# ---- what is packaged -------------------------------------------------------
# ARTIFACT_REF      the tag whose tree becomes the source package.
# ARTIFACT_OVERLAY  the tag supplying the packaging-only files (build scripts and
#                   judge-facing documents).  Both must name the tag cut on this
#                   commit: a pin left naming an earlier tag packages that earlier
#                   tree and nothing warns, because the two refs still agree.
ARTIFACT_REF=zmix-1.0
ARTIFACT_OVERLAY=zmix-1.0
ARTIFACT_LABEL="zmix 1.0"
ARTIFACT_RUN="the Form-1 enwik9 pair of these bytes: no-argument ./comp9 reading ./enwik9 in an otherwise empty directory -> archive9.exe, then no-argument ./archive9.exe -> data9, compared against enwik9."
ARTIFACT_TAG="zmix-1.0"

# ---- the scored compressor, as rebuilt by build.sh --------------------------
#   comp9 = armc_prefix ++ comp_recipe ++ comp_order ++ comp_tfweights ++ hdr16
#         = 160,884 + 65,993 + 173,640 + 2,815,630 + 16 = 3,216,163
#
# The dict slot carries the derived-dictionary RECIPE (65,993 = EXPECT_CD), not
# english.dic: the recipe is -Dderivdict=true, so the 99,222 B dictionary is
# DERIVED from enwik9 at encode time and is charged once, inside archive9.exe.
#
#   fixed cost of S = EXPECT_COMP9 + (EXPECT_ARMC + comp_dict + EXPECT_TFW + EXPECT_HDR)
#                   = 3,216,163 + (160,884 + 99,222 + 2,815,630 + 16) = 6,291,915
EXPECT_ARMC=160836
EXPECT_CD=65993
EXPECT_CO=173640
# The fifth segment is assets/6m-q4-fp32-t1lambda1.tfwc3, copied VERBATIM (magic
# FX2TFWC3), sha256 8e8ef3acacfb84437868035923bf9987f9adc826d2c833fb828204d2ab9c807d,
# which SHIP_RECIPE.env pins separately as ZMIX_TFWEIGHTS_SHA256.  It is 87.5 % of
# comp9 and Form-1 charges it TWICE.
# ⚠ NOT assets/6m-q4-fp32.tfwc3 (2,840,417 / c8919e6e…), which is present in the
#   package for provenance only.  assets/PROVENANCE.md is the authority.
EXPECT_TFW=2815630
# A transformer build's HeaderInfo has four fields (dict, order, payload, tfweights).
EXPECT_HDR=16
EXPECT_COMP9=3216115
EXPECT_COMP9_SHA=b329bba6a4a16d263bc76470cae1fedf24fe89524827ef06222dd1066ab7d496

# ---- the submitted archive (staged by make_package.sh --archive) ------------
#   S = |comp9| + |archive9.exe| + |comp9.args| = 3,216,163 + 96,096,261 + 0
#     = 99,312,424 = 6,291,915 (fixed) + 93,020,509 (payload)
# Both identities are exact:
#   160,884 + 99,222 + 2,815,630 + 93,020,509 + 16 = 96,096,261
#   6,291,915 + 93,020,509                         = 99,312,424
EXPECT_ARCHIVE_BYTES=96096261
EXPECT_ARCHIVE_SHA256=bb245678a769133e41ce34e3faf8b9df1270175b49fa30d8727cf9cc360071af

# ---- declared runtime policy ------------------------------------------------
# ⚠ Declared HERE and as a COMMENT in entry.env — never as an entry.env KEY.
#   RUNTIME_EXEC_POLICY as a key is an unsupported key and REJECTS the entry.
RUNTIME_EXEC_POLICY=strict

# ---- the judging harness this entry was measured against --------------------
HPJA_PIN=0bf7580ebe358b80ffc679f7863feaf1ebef88ea
HPJA_PIN_SUBJECT="Enforce cold-cache formal runs"
HPJA_FORMAL_RUN_FLAGS="--cold-cache --serial"
